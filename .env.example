# ==========================================
# ManufacturingAgent Environment Configuration
# ==========================================

# Active Provider: "ollama", "groq", or "fallback"
LLM_PROVIDER=fallback

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Groq Settings (Set your GROQ_API_KEY when using groq provider)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501

# RAG & Vector Store Settings
CHROMA_PERSIST_DIR=./data/chroma_db
DOCUMENTS_DIR=./data/documents
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Safety & Operational Bounds
MAX_RETRIEVAL_RESULTS=4
SIMILARITY_THRESHOLD=0.35
ENABLE_HUMAN_REVIEW_AUTO_QUEUE=true
